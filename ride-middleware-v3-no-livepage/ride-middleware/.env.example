# Copy to .env  (Windows: Copy-Item .env.example .env)  and change the values.
# .env is in .gitignore - NEVER commit it. Every teammate keeps their own copy.
# ---------------------------------------------------------------------------------------------
# 1) Which database?  Leave the Supabase lines commented to use the local postgres container.
# ---------------------------------------------------------------------------------------------
LOCAL_DB_PASSWORD=app
# for scripts on YOUR LAPTOP (check_counts, race_test, migrate):
DATABASE_URL=postgresql://app:app@localhost:5432/ridehail
# for the services INSIDE DOCKER (empty = local postgres container):
# DOCKER_DATABASE_URL=

# --- Supabase (Project Settings -> Database -> Connect). See docs/DATABASE.md ----------------
# Services (many connections)  -> TRANSACTION pooler :6543 (needs DB_PREPARE_THRESHOLD=none)
# Migrations + laptop scripts   -> SESSION pooler :5432
# DOCKER_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DOCKER_MIGRATE_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_PREPARE_THRESHOLD=none
# connections per service copy (Supabase free tier: use 2)
DB_POOL_MAX=5
# Grafana SQL panels read the same database:
# GRAFANA_DB_HOST=aws-0-<region>.pooler.supabase.com:5432
# GRAFANA_DB_NAME=postgres
# GRAFANA_DB_USER=postgres.<project-ref>
# GRAFANA_DB_PASSWORD=<db-password>
# GRAFANA_DB_SSLMODE=require

# ---------------------------------------------------------------------------------------------
# 2) Secrets for the platform - CHANGE THESE (any long random string; e.g. python -c "import secrets;print(secrets.token_urlsafe(24))")
# ---------------------------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis
RIDER_API_KEY=change-me-rider
DRIVER_API_KEY=change-me-driver
ADMIN_API_KEY=change-me-admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------------------------------------------------------------------------------------------
# 3) Laptop scripts (outside docker)
# ---------------------------------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092,localhost:9094,localhost:9096
REDIS_URL=redis://:change-me-redis@localhost:6379/0
API_URL=http://localhost:8000
MAX_RETRIES=3
# Simulator traffic (bookings per second). 0 = drivers only.
RIDER_RPS=2
# Autopilot: true = decide and report, but don't start/stop containers
AUTOPILOT_DRY_RUN=false
# DB tests against the docker postgres (they WIPE this database - name must contain "test"):
# TEST_DATABASE_URL=postgresql://app:app@localhost:5432/ridehail_test
